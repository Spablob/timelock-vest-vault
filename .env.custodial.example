# CustodialVault Deployment Configuration

# Deployer private key (without 0x prefix)
PRIVATE_KEY=

# Foundation address that can withdraw after lock period
CUSTODIAL_VAULT_FOUNDATION=0x0000000000000000000000000000000000000000

# Lender/Investor address that can withdraw on price drop
CUSTODIAL_VAULT_LENDER=0x0000000000000000000000000000000000000000

# Pyth price feed ID for IP token (now hardcoded in contract)
# Hardcoded value: 0xb620ba83044577029da7e4ded7a2abccf8e6afc2a0d4d26d89ccdd39ec109025
# CUSTODIAL_VAULT_PRICE_FEED_ID is no longer needed as it's hardcoded in the contract

# Initial IP token price in wei (18 decimals)
# Example: $1.00 = 1000000000000000000
CUSTODIAL_VAULT_INITIAL_PRICE=1000000000000000000

# Total expected token amount in wei
# Example: 1,000,000 IP = 1000000000000000000000000
CUSTODIAL_VAULT_TOKEN_AMOUNT=1000000000000000000000000

# Lock duration in days (e.g., 243 days ≈ 8 months)
CUSTODIAL_VAULT_LOCK_DAYS=243

# RPC URL for deployment
RPC_URL=https://story-testnet.rpc.caldera.xyz/http

# Verifier URL for contract verification
# Testnet: https://aeneid.storyscan.io/api
# Mainnet: https://www.storyscan.io/api
VERIFIER_URL=https://aeneid.storyscan.io/api

# Etherscan API key for verification (if applicable)
ETHERSCAN_API_KEY=